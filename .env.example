# Hedera testnet account from https://portal.hedera.com (ECDSA key)
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=0x...
# Optional: defaults to Hashio
# HEDERA_RPC_URL=https://testnet.hashio.io/api
# Seconds the oracle can correct results before payouts are allowed
DISPUTE_WINDOW=1800
# Set to 1 if the Solidity compiler download is blocked on your network
# USE_SOLCJS=1
